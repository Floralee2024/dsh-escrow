{
  "name": "dsh-escrow",
  "version": "0.3.21",
  "description": "延迟执行窗口：把 agent 的不可逆动作放进托管队列，批准才交割，超时默认拒绝。Deferred execution window (escrow) for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.mjs",
  "scripts": {
    "test": "node test/smoke.test.mjs",
    "test:all": "node test/smoke.test.mjs && node test/taste.test.mjs && node test/plugin.integration.test.mjs",
    "test:taste": "node test/taste.test.mjs",
    "test:integration": "node test/plugin.integration.test.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "escrow",
    "deferred-execution",
    "approval",
    "safety",
    "guardrail"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
